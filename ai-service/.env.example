DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/graysync
# ai_readonly role from schema.sql - only SELECT on the ai.v_* views, used
# exclusively by the text-to-SQL chat tool. Password must match the value
# passed as -v ai_readonly_password=... when applying schema.sql.
AI_READONLY_DATABASE_URL=postgresql://ai_readonly:yourpassword@localhost:5432/graysync
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=..
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=cohere.rerank-v3-5:0
AWS_ACCESS_KEY_ID=..
AWS_ACCESS_KEY_SECRET=..
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=..
